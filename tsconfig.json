{
    "compilerOptions": {
        "noImplicitAny": false,
        "target": "ES2020",
        "baseUrl": ".",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable",
            "ES2023"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@pages/*": [
                "src/pages/*"
            ],
            "@assets/*": [
                "src/assets/*"
            ],
            "@assets/fonts/*": [
                "src/assets/fonts/*"
            ],
            "@assets/images/*": [
                "src/assets/images/*"
            ],
            "@components/*": [
                "src/components/*"
            ],
            "@components/ui/*": [
                "src/components/ui/*"
            ],
            "@services/*": [
                "src/services/*"
            ],
            "@services/api/*": [
                "src/services/api/*"
            ],
            "@services/route/*": [
                "src/services/route/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@utils/constants/*": [
                "src/utils/constants/*"
            ],
            "@utils/hooks/*": [
                "src/utils/hooks/*"
            ],
            "@utils/string/*": [
                "src/utils/string/*"
            ]
        }
    },
    "include": [
        "src",
        "vite.config.ts"
    ]
}
