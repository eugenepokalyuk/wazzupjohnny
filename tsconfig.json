{
    "compilerOptions": {
        "noImplicitAny": false,
        "target": "ES2020",
        "baseUrl": ".",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable",
            "ES2023"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@app/*": [
                "src/app/*"
            ],
            "@pages/*": [
                "src/pages/*"
            ],
            "@widgets/*": [
                "src/widgets/*"
            ],
            "@features/*": [
                "src/features/*"
            ],
            "@entities/*": [
                "src/entities/*"
            ],
            "@shared/*": [
                "src/shared/*"
            ]
        }
    },
    "include": [
        "src",
        "vite.config.ts"
    ]
}
